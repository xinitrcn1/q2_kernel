#version 450
/*
 * Non-matvec ops of the fused GPU layer path, one per build (OP):
 *   2 CONV  Mamba2 causal depthwise conv + SiLU with resident state;
 *           dt = softplus(dt + bias)
 *   3 SCAN  Mamba2 selective scan, one subgroup per (head, channel):
 *           s = s*exp(dt*A) + dt*x*B; y = s.C + D*x; y *= silu(z)
 *   4 QBLK  per 256-block: [silu(a)*b | a], its sum of squares, times
 *           weights, as q8k
 * Buffers: W weights (f32 vectors stored as raw words), A activations
 * (as float and as uint words), S recurrent state.
 */
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Wb { uint W[]; };
layout(std430, binding = 1) buffer Ab { float A[]; };
layout(std430, binding = 2) buffer Xb { uint X[]; };
layout(std430, binding = 3) buffer Sb { float S[]; };

layout(push_constant) uniform PC { uint p[16]; } pc;

#define NONE 0xffffffffu

float wf(uint i) { return uintBitsToFloat(W[i]); }
float silu(float v) { return v / (1.0 + exp(-v)); }

#if OP == 4
shared float red[16];
shared int sq[256];

float wg_sum(float v)
{
	v = subgroupAdd(v);
	if (gl_SubgroupInvocationID == 0u)
		red[gl_SubgroupID] = v;
	barrier();
	float t = 0.0;
	for (uint i = 0u; i < gl_NumSubgroups; i++)
		t += red[i];
	barrier();
	return t;
}

float wg_max(float v)
{
	v = subgroupMax(v);
	if (gl_SubgroupInvocationID == 0u)
		red[gl_SubgroupID] = v;
	barrier();
	float t = red[0];
	for (uint i = 1u; i < gl_NumSubgroups; i++)
		t = max(t, red[i]);
	barrier();
	return t;
}

/* this workgroup's value v (thread t of the block) as q8k block at qo:
 * scale by the signed extreme, round to nearest even, as the CPU */
void q8k_block(float v, uint qo)
{
	uint t = gl_LocalInvocationID.x;
	float hi = wg_max(v), lo = -wg_max(-v);
	float mx = hi >= -lo ? hi : lo;
	int q = 0;
	if (mx != 0.0) {
		float is = -127.0 / mx;
		q = min(int(roundEven(is * v)), 127);
		if (t == 0u)
			X[qo] = floatBitsToUint(1.0 / is);
	} else if (t == 0u)
		X[qo] = 0u;
	sq[t] = q;
	barrier();
	if (t < 64u) {
		uint w = 0u;
		for (uint j = 0u; j < 4u; j++)
			w |= (uint(sq[4u * t + j]) & 255u) << (8u * j);
		X[qo + 1u + t] = w;
	} else if (t < 72u) {
		uint g = 2u * (t - 64u);
		int b0 = 0, b1 = 0;
		for (uint j = 0u; j < 16u; j++) {
			b0 += sq[16u * g + j];
			b1 += sq[16u * g + 16u + j];
		}
		X[qo + 65u + (t - 64u)] = (uint(b0) & 0xffffu) | (uint(b1) << 16);
	}
	barrier();
}
#endif

#if OP == 2
/* Mamba2 conv + SiLU over T tokens with resident state; the GPU's
 * channels c' < gch map to full-layout channel c = c' (< gdi: its x
 * channels) or DI + c' - gdi (B, C).  Also dt = softplus(dt + bias).
 * p: 0 zx (token 0), 1 zx stride, 2 xbc out, 3 xbc stride, 4 dt out,
 *    5 dt stride, 6 state, 7 conv w (W, [CH][4]), 8 conv b, 9 dt bias,
 *    10 gch, 11 heads, 12 gdi, 13 DI, 14 CH, 15 T */
void main()
{
	uint cp = gl_GlobalInvocationID.x, gch = pc.p[10], gdi = pc.p[12], T = pc.p[15];
	uint zs = pc.p[1];
	if (cp < pc.p[11]) {
		float bias = wf(pc.p[9] + cp);
		for (uint t = 0u; t < T; t++) {
			float d = A[pc.p[0] + t * zs + gdi + gch + cp] + bias;
			A[pc.p[4] + t * pc.p[5] + cp] = d > 20.0 ? d : log(1.0 + exp(d));
		}
	}
	if (cp >= gch)
		return;
	uint c = cp < gdi ? cp : pc.p[13] + cp - gdi, CH = pc.p[14];
	uint st = pc.p[6], w = pc.p[7] + 4u * c;
	float w0 = wf(w), w1 = wf(w + 1u), w2 = wf(w + 2u), w3 = wf(w + 3u), bc = wf(pc.p[8] + c);
	float s0 = S[st + c], s1 = S[st + CH + c], s2 = S[st + 2u * CH + c];
	for (uint t = 0u; t < T; t++) {
		float x = A[pc.p[0] + t * zs + gdi + cp];
		float v = s0 * w0 + s1 * w1 + s2 * w2 + x * w3 + bc;
		s0 = s1;
		s1 = s2;
		s2 = x;
		A[pc.p[2] + t * pc.p[3] + cp] = silu(v);
	}
	S[st + c] = s0;
	S[st + CH + c] = s1;
	S[st + 2u * CH + c] = s2;
}

#elif OP == 3
/* Mamba2 selective scan over T tokens: one workgroup per head of the
 * GPU's heads, 8 channels per subgroup with their d_state values in the
 * lanes' registers; a tile of tokens' B, C and dt is staged in shared
 * memory once for all 64 channels.
 * p: 0 xbc (x | B | C, token 0), 1 xbc stride, 2 dt, 3 dt stride,
 *    4 z (token 0), 5 z stride, 6 y out, 7 y stride, 8 state, 9 A (W),
 *    10 D (W), 11 channels (gdi), 12 d_state (<= 128), 13 head_dim
 *    (<= 8 x subgroups), 14 T */
#define STT 16u
#define RPW 8u
shared float sB[STT * 128u], sC[STT * 128u], sdt[STT];
void main()
{
	uint h = gl_WorkGroupID.x, gdi = pc.p[11], ds = pc.p[12], P = pc.p[13], T = pc.p[14];
	uint lane = gl_SubgroupInvocationID, sg = gl_SubgroupSize, tid = gl_LocalInvocationID.x;
	uint nk = ds / sg;          /* states per lane (d_state a multiple of the subgroup) */
	float Ah = wf(pc.p[9] + h), Dh = wf(pc.p[10] + h);
	float sv[RPW * 4u];
	uint rbase = h * P + gl_SubgroupID * RPW;

	for (uint i = 0u; i < RPW; i++)
		for (uint k = 0u; k < 4u; k++)
			sv[i * 4u + k] = (rbase + i < (h + 1u) * P && k < nk) ?
			    S[pc.p[8] + (rbase + i) * ds + lane + k * sg] : 0.0;
	for (uint t0 = 0u; t0 < T; t0 += STT) {
		uint nt = min(STT, T - t0);
		for (uint i = tid; i < nt * ds; i += gl_WorkGroupSize.x) {
			uint t = i / ds, n = i - t * ds, xb = pc.p[0] + (t0 + t) * pc.p[1] + gdi;
			sB[t * 128u + n] = A[xb + n];
			sC[t * 128u + n] = A[xb + ds + n];
		}
		if (tid < nt)
			sdt[tid] = A[pc.p[2] + (t0 + tid) * pc.p[3] + h];
		barrier();
		for (uint t = 0u; t < nt; t++) {
			float dt = sdt[t], dA = exp(dt * Ah);
			float bv[4], cv[4];
			for (uint k = 0u; k < 4u; k++) {
				bv[k] = k < nk ? sB[t * 128u + lane + k * sg] : 0.0;
				cv[k] = k < nk ? sC[t * 128u + lane + k * sg] : 0.0;
			}
			uint xb = pc.p[0] + (t0 + t) * pc.p[1];
			for (uint i = 0u; i < RPW; i++) {
				uint r = rbase + i;
				if (r >= (h + 1u) * P)
					break;
				float x = A[xb + r], xdt = x * dt, acc = 0.0;
				for (uint k = 0u; k < 4u; k++) {
					sv[i * 4u + k] = sv[i * 4u + k] * dA + bv[k] * xdt;
					acc += sv[i * 4u + k] * cv[k];
				}
				acc = subgroupAdd(acc);
				if (lane == 0u)
					A[pc.p[6] + (t0 + t) * pc.p[7] + r] = (acc + Dh * x) *
					    silu(A[pc.p[4] + (t0 + t) * pc.p[5] + r]);
			}
		}
		barrier();
	}
	for (uint i = 0u; i < RPW; i++)
		for (uint k = 0u; k < 4u; k++)
			if (rbase + i < (h + 1u) * P && k < nk)
				S[pc.p[8] + (rbase + i) * ds + lane + k * sg] = sv[i * 4u + k];
}
#elif OP == 5
/* bandwidth probe: p0 words to read (uvec4 units), p1 out (A) */
void main()
{
	uint n = pc.p[0], i = gl_GlobalInvocationID.x, st = gl_NumWorkGroups.x * 256u;
	uvec4 a = uvec4(0u);
	for (; i < n; i += st)
		a ^= uvec4(W[4u * i], W[4u * i + 1u], W[4u * i + 2u], W[4u * i + 3u]);
	if ((a.x ^ a.y ^ a.z ^ a.w) == 0x12345678u)
		A[pc.p[1]] = 1.0;
}

#elif OP == 4
/* one workgroup per (256-block, token): v = a | silu(a)*b; ss_out[k] =
 * sum v^2 (before weights); v *= w; q8k block k.
 * p: 0 a, 1 b (NONE: plain), 2 w (W words, NONE: none), 3 q_out (words),
 *    4 ss_out (A, per block; NONE: none), 5 a/b stride (floats),
 *    6 q stride (words), 7 ss stride */
void main()
{
	uint k = gl_WorkGroupID.x, t = gl_WorkGroupID.y;
	uint i = 256u * k + gl_LocalInvocationID.x;
	float v = A[pc.p[0] + t * pc.p[5] + i];
	if (pc.p[1] != NONE)
		v = silu(v) * A[pc.p[1] + t * pc.p[5] + i];
	if (pc.p[4] != NONE) {
		float s = wg_sum(v * v);
		if (gl_LocalInvocationID.x == 0u)
			A[pc.p[4] + t * pc.p[7] + k] = s;
	}
	if (pc.p[2] != NONE)
		v *= wf(pc.p[2] + i);
	q8k_block(v, pc.p[3] + t * pc.p[6] + 73u * k);
}
#endif
